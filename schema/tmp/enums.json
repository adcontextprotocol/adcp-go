{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "enums.json",
  "$defs": {
    "PropertyType": {
      "type": "string",
      "description": "PropertyType identifies the type of publisher property.",
      "enum": [
        "website",
        "mobile_app",
        "ctv_app",
        "desktop_app",
        "dooh",
        "podcast",
        "radio",
        "streaming_audio",
        "ai_assistant"
      ],
      "x-go-enum-prefix": "PropertyType",
      "x-go-enum-names": [
        "Website",
        "MobileApp",
        "CTVApp",
        "DesktopApp",
        "DOOH",
        "Podcast",
        "Radio",
        "StreamingAudio",
        "AIAssistant"
      ]
    },
    "UIDType": {
      "type": "string",
      "description": "UIDType identifies the type of user identifier token.",
      "enum": [
        "uid2",
        "rampid",
        "id5",
        "euid",
        "pairid",
        "maid",
        "hashed_email",
        "publisher_first_party",
        "other"
      ],
      "x-go-enum-prefix": "UIDType",
      "x-go-enum-names": [
        "UID2",
        "RampID",
        "ID5",
        "EUID",
        "PairID",
        "MAID",
        "HashedEmail",
        "PublisherFirstParty",
        "Other"
      ]
    },
    "PriceModel": {
      "type": "string",
      "description": "PriceModel identifies the pricing model for an offer.",
      "enum": [
        "cpm",
        "cpc",
        "cpcv",
        "cpa",
        "flat"
      ],
      "x-go-enum-prefix": "PriceModel",
      "x-go-enum-names": [
        "CPM",
        "CPC",
        "CPCV",
        "CPA",
        "Flat"
      ]
    },
    "ResponseType": {
      "type": "string",
      "description": "ResponseType declares what a publisher can accept back from context match.",
      "enum": [
        "activation",
        "catalog_items",
        "creative",
        "deal"
      ],
      "x-go-enum-prefix": "ResponseType",
      "x-go-enum-names": [
        "Activation",
        "CatalogItems",
        "Creative",
        "Deal"
      ]
    },
    "ErrorCode": {
      "type": "string",
      "description": "ErrorCode is a machine-readable error code.",
      "enum": [
        "invalid_request",
        "unknown_package",
        "rate_limited",
        "timeout",
        "internal_error",
        "provider_unavailable"
      ],
      "x-go-enum-prefix": "ErrorCode",
      "x-go-enum-names": [
        "InvalidRequest",
        "UnknownPackage",
        "RateLimited",
        "Timeout",
        "InternalError",
        "ProviderUnavailable"
      ]
    }
  }
}

# identity-agent — standalone Valkey example.
#
# Use this file as the basis for `docker run --env-file=example.standalone.env ...`
# Replace every <…> placeholder with a real value.
#
# In standalone mode both Valkey backends connect to a single endpoint and
# select a logical DB via *_VALKEY_DB. Only the "0" key in *_VALKEY_SHARDS
# is consulted.

# --- HTTP --------------------------------------------------------------------
HTTP_PORT=8080
REQUEST_TIMEOUT=40ms
# HTTP server (listener-side) timeouts. REQUEST_TIMEOUT is the per-request
# handler-internal budget; the four below are outer slow-client absorbing
# bounds. HTTP_WRITE_TIMEOUT must exceed REQUEST_TIMEOUT; HTTP_READ_TIMEOUT
# must be >= HTTP_READ_HEADER_TIMEOUT (Config.Validate enforces both).
HTTP_READ_HEADER_TIMEOUT=200ms
HTTP_READ_TIMEOUT=500ms
HTTP_WRITE_TIMEOUT=1s
HTTP_IDLE_TIMEOUT=30s
REQUEST_BODY_LIMIT_BYTES=65536
MAX_HEADER_BYTES=8192
# MAX_OPEN_CONNECTIONS caps concurrent TCP connections to the listener.
# New SYNs queue in the kernel backlog once the cap is hit. Pair with the
# container's file-descriptor ulimit. Watch the identity_agent_open_connections
# gauge to see if this needs to be raised.
MAX_OPEN_CONNECTIONS=1024
RESPONSE_TTL=60s
# STRICT_CONTENT_TYPE rejects requests whose Content-Type isn't
# application/json with 415. Default on; flip to false for legacy callers.
STRICT_CONTENT_TYPE=true
# ACCESS_LOG_ENABLED emits one INFO log line per request. Off by default
# at 10k QPS; useful in staging or for incident triage.
ACCESS_LOG_ENABLED=false
# ADMIN_PORT, when > 0, splits /metrics, /live, /debug/pprof onto a separate
# listener on that port so they can carry a different network policy than
# /identity. /health stays on HTTP_PORT regardless — it's part of the TMP
# protocol surface routers probe externally. Unset (=0) keeps everything on
# HTTP_PORT.
ADMIN_PORT=0
SHUTDOWN_GRACE=1s
SHUTDOWN_TIMEOUT=10s

# SUPPORTED_ADCP_MAJOR_VERSIONS is the comma-separated set of AdCP major
# versions this agent will accept on inbound `adcp_major_version`. Requests
# carrying an unsupported value are rejected with HTTP 400.
SUPPORTED_ADCP_MAJOR_VERSIONS=3

# --- Logging -----------------------------------------------------------------
LOG_LEVEL=info

# --- TMP signature verification ---------------------------------------------
# Required unless TMP_ALLOW_UNSIGNED=true (not recommended for production).
TMP_REGISTRY_URL=<https://router.example.com/registry/snapshot>
# The provider's registered BASE url, exactly as it appears as `endpoint` in the
# router's provider registration. The router appends /identity when dispatching
# and binds the request signature to this base value — including the path here
# makes every signature fail verification.
TMP_OWN_ENDPOINT_URL=<https://identity-agent.example.com>
TMP_ALLOW_UNSIGNED=false

# --- TMPX (optional; leave all blank to disable) ----------------------------
# To enable, set TMPX_ENCRYPT_JWKS_URL, TMPX_COUNTRY, and TMPX_SLOT_IDS.
# TMPX_SLOT_IDS is the ordered provider-local slot list (e.g. "primary" or
# "primary,secondary") the sealer pairs with the sealed token to populate
# tmpx_chunks[]; values MUST match the `tmpx_slots` this provider registers
# with the router. UID types without a registered decoder are silently
# dropped from the wire (the startup log enumerates which ones).
TMPX_ENCRYPT_JWKS_URL=
TMPX_ENCRYPT_JWKS_TTL=5m
TMPX_COUNTRY=
TMPX_PRIORITY=
TMPX_SLOT_IDS=

# --- LiveRamp sidecar (optional; controls RampID decoding) ------------------
# When LIVERAMP_SIDECAR_URL is empty, RampID / RampID-derived identities are
# silently ignored when producing TMPX tokens.
LIVERAMP_SIDECAR_URL=
# Defaults to 15ms / 5ms — sized to fit the agent's 40ms REQUEST_TIMEOUT.
# Setting these larger than the request budget makes the timeouts moot.
LIVERAMP_SIDECAR_TIMEOUT=15ms
LIVERAMP_SIDECAR_DIAL_TIMEOUT=5ms

# --- Identity-config source (Scope3) ----------------------------------------
CONFIG_SOURCE_URL=<https://config.scope3.com/v1/identity-configs>
CONFIG_SOURCE_TOKEN=<bearer-token>
CONFIG_SOURCE_TIMEOUT=30s
CONFIG_REFRESH_INTERVAL=5m
# CONFIG_START_MODE governs behavior when the initial fetch fails:
#   retry       — block startup retrying until CONFIG_START_RETRY_DEADLINE (default)
#   fail-fast   — exit on the first failure
#   best-effort — start with an empty snapshot; rely on refresh
CONFIG_START_MODE=retry
CONFIG_START_RETRY_DEADLINE=5m
# CONFIG_SOURCE_EXTRA_HEADERS adds arbitrary headers to every config-source
# request on top of the managed Authorization/Content-Type/Accept set. JSON
# object of name→value; collisions with the managed headers are rejected at
# startup. Leave unset (or empty) to send no extras.
# CONFIG_SOURCE_EXTRA_HEADERS={"X-Header-A":"value-a","X-Header-B":"value-b"}

# --- Audience Valkey (optional; omit AUDIENCE_VALKEY_SHARDS to disable) -----
# When unconfigured, any package with a non-empty TargetSegments rule is
# ineligible at request time.
AUDIENCE_VALKEY_MODE=standalone
AUDIENCE_VALKEY_SHARDS={"0":"<audience.valkey.example.com:6379>"}
AUDIENCE_VALKEY_USERNAME=
AUDIENCE_VALKEY_PASSWORD=<password>
AUDIENCE_VALKEY_DB=0
AUDIENCE_VALKEY_TLS=false
AUDIENCE_VALKEY_DIAL_TIMEOUT=5s
AUDIENCE_VALKEY_READ_TIMEOUT=20ms
AUDIENCE_VALKEY_POOL_SIZE=0
AUDIENCE_TIMEOUT=10ms

# --- Frequency-cap Valkey (required) ----------------------------------------
FCAP_VALKEY_MODE=standalone
FCAP_VALKEY_SHARDS={"0":"<fcap.valkey.example.com:6379>"}
FCAP_VALKEY_USERNAME=
FCAP_VALKEY_PASSWORD=<password>
FCAP_VALKEY_DB=0
FCAP_VALKEY_TLS=false
FCAP_VALKEY_DIAL_TIMEOUT=5s
FCAP_VALKEY_READ_TIMEOUT=20ms
FCAP_VALKEY_POOL_SIZE=0
FCAP_TIMEOUT=10ms

# --- Metrics (optional) ------------------------------------------------------
# When enabled, /metrics is served on HTTP_PORT.
METRICS_ENABLED=false
METRICS_NAMESPACE=identity_agent

# --- pprof (optional; disabled by default) ----------------------------------
PPROF_ENABLED=false

# context-agent — standalone Valkey example.
#
# Use this file as the basis for `docker run --env-file=example.standalone.env ...`
# Replace every <…> placeholder with a real value.

# --- HTTP --------------------------------------------------------------------
HTTP_PORT=8081
REQUEST_TIMEOUT=40ms
HTTP_READ_HEADER_TIMEOUT=200ms
HTTP_READ_TIMEOUT=500ms
HTTP_WRITE_TIMEOUT=1s
HTTP_IDLE_TIMEOUT=30s
REQUEST_BODY_LIMIT_BYTES=262144
MAX_HEADER_BYTES=8192
MAX_OPEN_CONNECTIONS=1024
RESPONSE_TTL=60s
STRICT_CONTENT_TYPE=true
ACCESS_LOG_ENABLED=false
# ADMIN_PORT > 0 splits /metrics, /live, /debug/pprof onto a separate listener.
ADMIN_PORT=0
SHUTDOWN_GRACE=1s
SHUTDOWN_TIMEOUT=10s

SUPPORTED_ADCP_MAJOR_VERSIONS=3

# --- Logging -----------------------------------------------------------------
LOG_LEVEL=info

# --- Identity & provider stamping --------------------------------------------
# PROVIDER_ID is stamped into suppression keys and emitted on logs / metrics.
# It must match the provider_id this deployment is registered under in the
# router's provider list.
PROVIDER_ID=<your-provider-id>
# SELLER_AGENT_URL is the canonicalized seller_agent_url this deployment
# represents. Same byte-for-byte string match the identityconfig service uses.
SELLER_AGENT_URL=<https://seller.example.com/agent>

# --- Accepted taxonomies -----------------------------------------------------
# Comma-separated list of "source:id" pairs. A publisher's ContextSignals
# topics under a taxonomy NOT in this list are silently dropped, and every
# TopicTargets package without artifact-side topic data fails-closed for
# that request. Required when any package uses TopicTargets.
ACCEPTED_TAXONOMIES=iab:7

# --- Property bitmap (stopgap until registry hookup) -------------------------
# Comma-separated property_rid values the agent will accept. Requests
# whose property_rid is not in this list short-circuit at the top of
# Evaluate (the global property bitmap check). A follow-up wires this
# from a registry.Syncer + the persistent registry store from PR #358.
PROPERTY_RIDS=<rid-1>,<rid-2>

# --- TMP signature verification ---------------------------------------------
TMP_REGISTRY_URL=<https://router.example.com/registry/snapshot>
TMP_OWN_ENDPOINT_URL=<https://context-agent.example.com/context>
TMP_ALLOW_UNSIGNED=false

# --- Valkey backend (required) -----------------------------------------------
VALKEY_MODE=standalone
VALKEY_SHARDS={"0":"<context.valkey.example.com:6379>"}
VALKEY_USERNAME=
VALKEY_PASSWORD=<password>
VALKEY_DB=0
VALKEY_TLS=false
VALKEY_DIAL_TIMEOUT=5s
VALKEY_READ_TIMEOUT=20ms
VALKEY_WRITE_TIMEOUT=50ms
VALKEY_POOL_SIZE=0

# --- Suppression snapshot ----------------------------------------------------
# How often the agent re-scans suppress:{provider_id}:* into its in-memory
# snapshot. External writes (operator action, future writer pipeline)
# become visible within this interval.
SUPPRESSION_REFRESH_INTERVAL=5m

# --- LRU caches --------------------------------------------------------------
# Master switch. When false, every reader is direct (no caching).
CACHE_ENABLED=true

# Per-domain enable flags and sizing. Each cache holds (value, present)
# tuples so a miss caches the absence under the same TTL.
CACHE_MEDIABUY_ENABLED=true
CACHE_MEDIABUY_SELLER_SIZE=1024
CACHE_MEDIABUY_SELLER_TTL=5m
CACHE_MEDIABUY_RECORD_SIZE=4096
CACHE_MEDIABUY_RECORD_TTL=5m

CACHE_PKGCONFIG_ENABLED=true
CACHE_PKGCONFIG_SIZE=4096
CACHE_PKGCONFIG_TTL=5m

CACHE_URLLIST_ENABLED=true
CACHE_URLLIST_SIZE=16384
CACHE_URLLIST_TTL=1m

CACHE_TOPICS_ENABLED=true
# Artifact cache is the dominant cardinality: one entry per (URL, taxonomy).
CACHE_TOPICS_ARTIFACT_SIZE=65536
CACHE_TOPICS_ARTIFACT_TTL=5m
CACHE_TOPICS_PACKAGE_SIZE=4096
CACHE_TOPICS_PACKAGE_TTL=5m

# --- Metrics (optional) ------------------------------------------------------
METRICS_ENABLED=false
METRICS_NAMESPACE=context_agent

# --- pprof (optional) --------------------------------------------------------
PPROF_ENABLED=false

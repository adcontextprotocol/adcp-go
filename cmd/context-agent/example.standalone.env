# context-agent — standalone Valkey example.
#
# Use this file as the basis for `docker run --env-file=example.standalone.env ...`
# Replace every <…> placeholder with a real value.

# --- HTTP --------------------------------------------------------------------
HTTP_PORT=8081
REQUEST_TIMEOUT=40ms
HTTP_READ_HEADER_TIMEOUT=200ms
HTTP_READ_TIMEOUT=500ms
HTTP_WRITE_TIMEOUT=1s
HTTP_IDLE_TIMEOUT=30s
REQUEST_BODY_LIMIT_BYTES=262144
MAX_HEADER_BYTES=8192
MAX_OPEN_CONNECTIONS=1024
RESPONSE_TTL=60s
STRICT_CONTENT_TYPE=true
# ADMIN_PORT > 0 splits /metrics, /live, /debug/pprof onto a separate listener
# (recommended in production so admin surfaces are reachable only on the
# internal interface and never share the request port). Set PPROF_ENABLED=true
# only when ADMIN_PORT > 0 — the validator rejects pprof on the public port.
ADMIN_PORT=0
SHUTDOWN_GRACE=1s
SHUTDOWN_TIMEOUT=10s

SUPPORTED_ADCP_MAJOR_VERSIONS=3

# --- Logging -----------------------------------------------------------------
LOG_LEVEL=info

# --- Identity & provider stamping --------------------------------------------
# PROVIDER_ID is stamped into suppression keys and emitted on logs / metrics.
# It must match the provider_id this deployment is registered under in the
# router's provider list.
#
# The seller this request is for is NOT configured here — it arrives on each
# request as `seller_agent_url`, so one deployment serves every seller it has
# synced packages for.
PROVIDER_ID=<your-provider-id>

# --- Accepted taxonomies -----------------------------------------------------
# Comma-separated list of "source:id" pairs. A publisher's ContextSignals
# topics under a taxonomy NOT in this list are silently dropped, and every
# TopicTargets package without artifact-side topic data fails-closed for
# that request. Required when any package uses TopicTargets.
ACCEPTED_TAXONOMIES=iab:7

# --- Property bitmap ---------------------------------------------------------
# Static fallback used when REGISTRY_ENABLED=false (or no registry feed
# is reachable). Comma-separated property_rid values the agent accepts;
# requests whose property_rid is not in this list short-circuit at the
# top of Evaluate. Each value is a catalog property_rid — the UUID v7
# the property catalog assigns and that the request carries (NOT the
# publisher's property_id slug). Production deployments should leave
# this blank and rely on REGISTRY_ENABLED=true to hydrate the bitmap
# from the AgenticAdvertising registry feed instead.
PROPERTY_RIDS=<property-rid-uuid-1>,<property-rid-uuid-2>

# --- Registry sync (optional, opt-in) ----------------------------------------
# When REGISTRY_ENABLED=true the agent starts a background sync loop
# against the AgenticAdvertising registry feed and feeds the resulting
# PropertyIndex into the engine's global property bitmap. PROPERTY_RIDS
# is ignored when the registry-sourced bitmap is in use.
REGISTRY_ENABLED=false
REGISTRY_FEED_URL=<https://registry.agenticadvertising.org>
REGISTRY_FEED_TOKEN=<bearer-token>
REGISTRY_POLL_INTERVAL=30s
REGISTRY_FEED_LIMIT=1000
REGISTRY_BOOTSTRAP_LIMIT=10000
# REGISTRY_CURSOR_PATH persists the feed cursor across restarts so a
# restart resumes against it instead of re-bootstrapping. Required in
# production; leave blank to keep the cursor in memory only.
REGISTRY_CURSOR_PATH=

# REGISTRY_STORE_BACKEND selects how the registry indexes are persisted:
#   memory — no persistent index; every cold start re-bootstraps from
#            the feed. Recommended for short-lived dev workloads only.
#   redis  — index + cursor persisted in Valkey/Redis via the
#            registry/redisstore package. Recommended for production.
REGISTRY_STORE_BACKEND=memory
REGISTRY_KEY_PREFIX=adcp:registry:context-agent
# REGISTRY_REDIS_* are required when REGISTRY_STORE_BACKEND=redis.
# This endpoint is intentionally distinct from the request-path Valkey
# (VALKEY_*) above so the registry's small steady-state load does not
# share connection pools with the latency-sensitive targeting reads.
REGISTRY_REDIS_ADDR=<registry.valkey.example.com:6379>
REGISTRY_REDIS_USERNAME=
REGISTRY_REDIS_PASSWORD=<password>
REGISTRY_REDIS_DB=0
REGISTRY_REDIS_TLS=false

# --- TMP signature verification ---------------------------------------------
TMP_REGISTRY_URL=<https://router.example.com/registry/snapshot>
TMP_OWN_ENDPOINT_URL=<https://context-agent.example.com/context>
TMP_ALLOW_UNSIGNED=false

# --- Valkey backend (required) -----------------------------------------------
# Single Valkey instance serves every read path: media-buy, package
# context configs, URL lists, topic sets, suppression markers, AND the
# `signal:{signal_owner_id}:{key_types}:{values}` keyspace populated
# by the signal writer. Point this at the same Valkey cluster the
# signal writer populates so context-signal targeting evaluates in a
# single MGet per request. Cluster and shadow-shard topologies are
# supported; multi-key operations route per slot inside the store.
VALKEY_MODE=standalone
VALKEY_SHARDS={"0":"<context.valkey.example.com:6379>"}
VALKEY_USERNAME=
VALKEY_PASSWORD=<password>
VALKEY_DB=0
VALKEY_TLS=false
VALKEY_DIAL_TIMEOUT=5s
VALKEY_READ_TIMEOUT=20ms
VALKEY_WRITE_TIMEOUT=50ms
VALKEY_POOL_SIZE=0

# --- Suppression snapshot ----------------------------------------------------
# How often the agent re-scans suppress:{provider_id}:* into its in-memory
# snapshot. External writes (operator action, future writer pipeline)
# become visible within this interval.
SUPPRESSION_REFRESH_INTERVAL=5m

# --- LRU caches --------------------------------------------------------------
# Master switch. When false, every reader is direct (no caching).
CACHE_ENABLED=true

# Per-domain enable flags and sizing. Each cache holds (value, present)
# tuples so a miss caches the absence under the same TTL.
CACHE_MEDIABUY_ENABLED=true
CACHE_MEDIABUY_SELLER_SIZE=1024
CACHE_MEDIABUY_SELLER_TTL=5m
CACHE_MEDIABUY_RECORD_SIZE=4096
CACHE_MEDIABUY_RECORD_TTL=5m

CACHE_PKGCONFIG_ENABLED=true
CACHE_PKGCONFIG_SIZE=4096
CACHE_PKGCONFIG_TTL=5m

CACHE_TOPICS_ENABLED=true
# Artifact cache is the dominant cardinality: one entry per (URL, taxonomy).
CACHE_TOPICS_ARTIFACT_SIZE=65536
CACHE_TOPICS_ARTIFACT_TTL=5m
CACHE_TOPICS_PACKAGE_SIZE=4096
CACHE_TOPICS_PACKAGE_TTL=5m

# --- Metrics (optional) ------------------------------------------------------
# METRICS_ENABLED=true requires ADMIN_PORT > 0. /metrics on the public /context
# listener would expose internal histograms — including a timing oracle on
# signature verification outcomes — to anyone who can reach the request port,
# so the validator refuses that combination. Either set ADMIN_PORT or keep
# METRICS_ENABLED=false.
METRICS_ENABLED=false
METRICS_NAMESPACE=context_agent

# --- pprof (optional) --------------------------------------------------------
PPROF_ENABLED=false

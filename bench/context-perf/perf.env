# Bench-wide env: values that must agree across the seeder, loadgen,
# and context-agent services. Loaded into every service that needs
# them via `env_file:` in docker-compose.yml — single source of truth.
# Do NOT set these in scenarios/*.env or via `docker compose run -e`
# — override here and every service picks up the same value.

# PROPERTY_RIDS: comma-separated UUIDv7 strings. Every service reads
# this via env; internal/corpus.PropertyRIDs() parses it. If you edit
# this, no code change is needed.
PROPERTY_RIDS=019700ff-0001-7000-8000-000000000001,019700ff-0001-7000-8000-000000000002,019700ff-0001-7000-8000-000000000003,019700ff-0001-7000-8000-000000000004,019700ff-0001-7000-8000-000000000005

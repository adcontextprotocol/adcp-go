# Scenario: baseline throughput. Every request evaluates against the
# full active-package set for a seller; no artifact_refs, no topic
# gate, no context signals. Exercises the mediabuystore +
# pkgconfigstore MGet path only.

SCENARIO=packages-only
SELLER_AGENT_URL=https://seller.perf.local/agent

# Corpus
TOTAL_PACKAGES=200
TOTAL_ARTIFACTS=1000
TOPIC_TARGETS_ENABLED=false
SIGNALS_ENABLED=false

# Loadgen shape
PACKAGES_PER_REQ=0
ARTIFACT_REFS_PER_REQ=0

# Scenario: packages + artifact_refs → topic-set intersection. Every
# active package carries TopicTargets=true; the seeder attaches a
# shared always-on topic (index 0) to every package AND every artifact
# so the engine's per-package ArtifactTopics / PackageTopics fan-out
# always hits a non-empty intersection. Exercises the topicstore
# SetMembers path (topics:artifact:*, topics:package:*).

SCENARIO=packages-topics
SELLER_AGENT_URL=https://seller.perf.local/agent

# Corpus
TOTAL_PACKAGES=200
TOTAL_ARTIFACTS=1000
TOPIC_TARGETS_ENABLED=true
TOTAL_TOPICS=500
TOPICS_PER_PACKAGE=5
TOPICS_PER_ARTIFACT=10
SIGNALS_ENABLED=false

# Loadgen shape
PACKAGES_PER_REQ=0
ARTIFACT_REFS_PER_REQ=3

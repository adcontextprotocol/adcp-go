# Scenario: packages + context-signal targeting via url_hash. Every
# active package's ContextSignals profile carries an any_of Cfg gated
# on a shared signal_id under key_type=url_hash. The loadgen sends
# url_hash artifact_refs whose values map to seeded signal keys, so
# the engine's PlanLookup / DecodeValues MGet path fires with a full
# hit rate.
#
# The signal-key count is fixed to TOTAL_ARTIFACTS by the seeder (one
# key per URL in the loadgen's artifact pool) — no separate
# SIGNAL_VALUES knob to keep the two pools from silently decoupling.

SCENARIO=packages-signals
SELLER_AGENT_URL=https://seller.perf.local/agent

# Corpus
TOTAL_PACKAGES=200
TOTAL_ARTIFACTS=1000
TOPIC_TARGETS_ENABLED=false
SIGNALS_ENABLED=true

# Loadgen shape
PACKAGES_PER_REQ=0
ARTIFACT_REFS_PER_REQ=3

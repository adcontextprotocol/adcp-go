# Scenario: frequency capping + audience targeting. Half the packages carry
# an anyOf audience rule (3 audiences each). Both Valkey backends are read
# per request.

SCENARIO=fcap-audience
SELLER_AGENT_URL=https://seller.perf.local/agent

# Config surface
TOTAL_PACKAGES=200
AUDIENCE_PACKAGES=100
AUDIENCES_PER_PACKAGE=3
TOTAL_AUDIENCES=500

# Seeded users
TOTAL_USERS=100000
AUDIENCES_PER_USER=5
FCAP_USER_FRACTION=0.5
PACKAGES_CAPPED_PER_USER=10

# Loadgen shape
PACKAGES_PER_REQ=20
IDENTITIES_PER_REQ=1

# Scenario: only frequency capping. No package carries an audience rule, so
# the audience Valkey is not exercised per-request. Measures the pure
# fcap-lookup + TMP-decode path.

SCENARIO=fcap-only
SELLER_AGENT_URL=https://seller.perf.local/agent

# Config surface (used by both configserver and loadgen)
TOTAL_PACKAGES=200
AUDIENCE_PACKAGES=0
AUDIENCES_PER_PACKAGE=0
TOTAL_AUDIENCES=1

# Seeded users
TOTAL_USERS=100000
AUDIENCES_PER_USER=0
FCAP_USER_FRACTION=0.5
PACKAGES_CAPPED_PER_USER=10

# Loadgen shape
PACKAGES_PER_REQ=20
IDENTITIES_PER_REQ=1

# Scenario: exercise Valkey enough to find its scaling ceiling.
#
# 50 packages per request (out of a 500-package pool) generates ~50 fcap
# HEXISTS + ~75 audience HEXISTS per request, so QPS in the low thousands
# already pushes Valkey into meaningful load — 4k QPS ≈ 500k HEXISTS/sec.
# That lets a single identity-agent instance saturate one Valkey shard
# before it saturates its own CPU.

SCENARIO=valkey-scaling
SELLER_AGENT_URL=https://seller.perf.local/agent

# Config surface — bigger catalog to draw 50 packages from without repetition.
TOTAL_PACKAGES=500
AUDIENCE_PACKAGES=250
AUDIENCES_PER_PACKAGE=3
TOTAL_AUDIENCES=1000

# Seeded users
TOTAL_USERS=100000
AUDIENCES_PER_USER=5
FCAP_USER_FRACTION=0.5
PACKAGES_CAPPED_PER_USER=25

# Loadgen shape — heavy HEXISTS-per-request to load Valkey with modest QPS.
PACKAGES_PER_REQ=50
IDENTITIES_PER_REQ=1

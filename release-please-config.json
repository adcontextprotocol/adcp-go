    },
    "registry/redisstore": {
      "release-type": "go",
      "component": "registry/redisstore",
      "tag-separator": "/",
      "bump-minor-pre-major": true,
      "include-component-in-tag": true
    },
    "registry/glidestore": {
      "release-type": "go",
      "component": "registry/glidestore",
      "tag-separator": "/",
      "bump-minor-pre-major": true,
      "include-component-in-tag": true
    }
  }
